# FoodSave Environment Configuration Example
# Copy this file to .env.local: cp .env.example .env.local

# Database (SQLite for zero-config local / serverless deployment, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# NextAuth Authentication
NEXTAUTH_SECRET="foodsave-development-secret-key-32chars"
NEXTAUTH_URL="http://localhost:3000"

# External API Integrations (Optional)
SPOONACULAR_API_KEY=""
SENDGRID_API_KEY=""
