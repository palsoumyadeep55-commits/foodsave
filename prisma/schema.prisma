generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  individual
  donor
  ngo
  admin
}

enum ListingStatus {
  active
  claimed
  completed
  expired
  cancelled
}

enum ClaimStatus {
  pending
  approved
  rejected
  fulfilled
  no_show
}

enum IngredientCategory {
  produce
  dairy
  meat
  pantry
  frozen
  other
}

enum LocationType {
  community_fridge
  food_bank
  shelter
}

enum WasteUnit {
  kg
  lbs
  items
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  fullName     String
  primaryRole  UserRole  @default(individual)
  phoneNumber  String?
  image        String?
  emailVerified DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  donorProfile     DonorProfile?
  ngoProfile       NgoProfile?
  fridgeIngredients FridgeIngredient[]
  savingsLogs      SavingsLog[]
  wasteLogs        WasteLog[]
  listingClaims    ListingClaim[]
  managedLocations CommunityLocation[]

  @@map("users")
}

model DonorProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  businessName String
  description  String?  @db.Text
  address      String   @db.Text
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
  listings     FoodListing[]
  @@map("donor_profiles")
}

model NgoProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  organizationName String
  taxId            String?
  address          String   @db.Text
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  isVerified       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  @@map("ngo_profiles")
}

model FoodListing {
  id                  String        @id @default(uuid())
  donorId             String
  title               String
  description         String?       @db.Text
  quantityDescription String
  expiryTime          DateTime
  pickupStartTime     DateTime
  pickupEndTime       DateTime
  status              ListingStatus @default(active)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
  donor               DonorProfile  @relation(fields: [donorId], references: [id])
  claims              ListingClaim[]
  @@map("food_listings")
}

model ListingClaim {
  id          String      @id @default(uuid())
  listingId   String
  claimerId   String
  status      ClaimStatus @default(pending)
  pickupNotes String?     @db.Text
  claimedAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  listing     FoodListing @relation(fields: [listingId], references: [id])
  claimer     User        @relation(fields: [claimerId], references: [id])
  @@map("listing_claims")
}

model FridgeIngredient {
  id          String              @id @default(uuid())
  userId      String
  name        String
  category    IngredientCategory
  quantity    Decimal?            @db.Decimal(10, 2)
  unit        String?
  expiryDate  DateTime            @db.Date
  addedAt     DateTime            @default(now())
  consumedAt  DateTime?
  discardedAt DateTime?
  user        User                @relation(fields: [userId], references: [id])
  @@map("fridge_ingredients")
}

model SavingsLog {
  id          String   @id @default(uuid())
  userId      String
  amountSaved Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  description String?  @db.Text
  recordedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  @@map("savings_log")
}

model CommunityLocation {
  id             String       @id @default(uuid())
  name           String
  type           LocationType
  address        String       @db.Text
  latitude       Decimal?     @db.Decimal(10, 8)
  longitude      Decimal?     @db.Decimal(11, 8)
  managedBy      String?
  operatingHours String?      @db.Text
  isVerified     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  manager        User?        @relation(fields: [managedBy], references: [id])
  inventory      LocationInventory[]
  needs          LocationNeed[]
  @@map("community_locations")
}

model LocationInventory {
  id         String            @id @default(uuid())
  locationId String
  itemName   String
  quantity   Decimal?          @db.Decimal(10, 2)
  unit       String?
  lastUpdated DateTime         @default(now())
  updatedBy  String?
  location   CommunityLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  @@map("location_inventory")
}

model LocationNeed {
  id          String            @id @default(uuid())
  locationId  String
  itemName    String
  urgencyLevel Int              @db.SmallInt
  fulfilled   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  location    CommunityLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  @@map("location_needs")
}

model WasteLog {
  id             String        @id @default(uuid())
  userId         String
  itemName       String
  category       String
  quantity       Decimal       @db.Decimal(10, 2)
  unit           WasteUnit
  estimatedCost  Decimal?      @db.Decimal(10, 2)
  carbonFootprint Decimal?     @db.Decimal(10, 4)
  reason         String?
  loggedAt       DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id])
  @@map("waste_logs")
}
